{
  "target": {
    "adapters": "stub",
    "rest": {
      "base_url": "${MX_GUMI_API_BASE}",
      "entries": {
        "summary_prod": {
          "method": "POST",
          "path": "/summary/prod",
          "body_schema": {
            "part_code": "list[str]",
            "line_code": "list[str]",
            "date": "str"
          }
        },
        "list_lines": {
          "method": "GET",
          "path": "/lines",
          "query_schema": {
            "active": "bool"
          }
        }
      }
    },
    "mongo": {
      "url": "${MX_GUMI_MONGO_URL}"
    },
    "redis": {
      "url": "${MX_GUMI_REDIS_URL}"
    },
    "code": {
      "repos": [
        {
          "name": "twin-services",
          "path": "./ref"
        }
      ]
    }
  },
  "patrol": {
    "checks": {
      "api.oee_range": {
        "judge": "rule",
        "schedule": {
          "interval": "5m"
        },
        "target": "rest:/api/v1/lines/{line}/oee",
        "params": {
          "rule": "range",
          "field": "body.oee",
          "min": 0,
          "max": 100
        }
      },
      "prod.badge_nonzero": {
        "judge": "rule",
        "schedule": {
          "interval": "5m"
        },
        "target": "rest:summary_prod",
        "params": {
          "rule": "exists",
          "field": "body.badge",
          "body": {
            "part_code": [
              "P001"
            ]
          }
        },
        "resolve": {
          "line_code": {
            "from": "mongo",
            "collection": "lines",
            "field": "line_code",
            "filter": {
              "active": true
            },
            "cardinality": "first:50"
          },
          "date": {
            "from": "clock",
            "expr": "today"
          }
        }
      }
    }
  },
  "knowledge": {
    "root": "knowledge.example"
  }
}

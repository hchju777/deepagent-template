{
  "infra": {
    "mongodb": {
      "user": "dmfReadOnly"
    },
    "kafka": {
      "consumer": {
        "topic": {
          "topic1": "GUMI_TOPIC"
        }
      }
    },
    "rest": {
      "timeout_s": 10,
      "entries": {
        "summary_badge": {
          "method": "POST",
          "path": "/summary/badge",
          "params": {
            "part_code": {
              "type": "list",
              "required": false
            },
            "line_code": {
              "type": "list",
              "required": false
            }
          }
        },
        "oee_summary": {
          "method": "POST",
          "path": "/api/v1/oee/summary",
          "params": {
            "line": {
              "type": "str",
              "required": true
            },
            "date": {
              "type": "str",
              "required": false
            }
          }
        },
        "lines": {
          "method": "GET",
          "path": "/api/v1/lines"
        },
        "prod_status": {
          "method": "POST",
          "path": "/summary/prod_status",
          "params": {
            "part_code": {
              "type": "list",
              "required": false
            },
            "line_code": {
              "type": "list",
              "required": false
            }
          }
        }
      }
    }
  },
  "code": {
    "repos": [
      {
        "name": "dt-core",
        "url": "https://git.example.com/team/dt-core",
        "path": "../target-code/dt-core",
        "token": "${GIT_TOKEN}"
      },
      {
        "name": "dt-api",
        "url": "https://git.example.com/team/dt-api",
        "path": "../target-code/dt-api",
        "token": "${GIT_TOKEN}"
      }
    ]
  }
}

{
  "timezone": "Asia/Seoul",
  "output_dir": "output",
  "llm": {
    "adapter": "chat_model",
    "provider": "openai_compatible",
    "model": "gauss-o-flash",
    "model_id": "339",
    "temperature": 0.0,
    "base_url": "${LLM_BASE_URL}",
    "pass_key": "${LLM_PASS_KEY}",
    "client_key": "${LLM_CLIENT_KEY}",
    "tls": {
      "use_system_store": true
    },
    "expect_reported_model": "openai/gpt-oss-120b"
  },
  "investigation": {
    "max_rounds": 6,
    "parallel_width": 3,
    "max_tasks": 24,
    "evidence_chars": 2400,
    "evidence_total_chars": 12000,
    "frame_prompt": "prompts/investigate-frame.md",
    "integrate_prompt": "prompts/investigate-integrate.md"
  },
  "mail": {
    "enabled": true,
    "recipients": [
      "ops-mx-gumi@example.com",
      "line-lead@example.com"
    ],
    "api_base": "https://agent.example.net/api/v1/run",
    "agent_id": "${MAIL_AGENT_ID}",
    "api_key": "${MAIL_AGENT_API_KEY}",
    "subject_prefix": "[운영리포트]",
    "tls": {
      "use_system_store": true
    }
  },
  "case_store": "output/cases.json"
}

# 실제 값은 .env에 넣는다(.gitignore됨). 이 파일은 "어떤 키가 필요한가"의 문서다.
# config가 ${...}로 참조하는 키가 비어 있으면 기동이 거부된다 — 빈 값도 없는 것으로 친다.
#
# ── 이름 규칙 ────────────────────────────────────────────────────────
#   {무엇에 붙는가}_{무엇인가}        예: LLM_PASS_KEY, MAIL_AGENT_API_KEY
#
# 벤더 이름(GAUSS_, FABRIX_)을 넣지 않는다. 게이트웨이가 교체되면 그 이름이
# 거짓말이 되고, 이름을 고치려면 모든 배치의 .env를 같이 고쳐야 한다.
# LLM 쪽도 같은 이유로 `LLM_*`이다 — 사내 게이트웨이든 OpenAI든 같은 자리다.
#
# 그리고 **비밀이 아닌 것은 여기 두지 않는다.** 모델 ID·Agent ID·수신자 목록은
# config에 적는다. 여기 두면 "이 배치가 무엇을 하는 설정인지" 보려고 매번
# .env를 열어야 하고, .env는 git에 없어서 리뷰도 안 된다.
# 하이픈이 든 이름(`MAIL-Address`)은 쓰지 않는다 — 셸에서 설정할 수 없다.

# ─── 대상 시스템 접속 (전 법인 공통) ─────────────────────────────
# 비밀번호가 법인마다 같으므로 키에 사이트 접두사를 붙이지 않는다. 그래서
# 참조도 fct 층이 아니라 gbm/common.json에 한 번만 적혀 있다.
# Mongo는 user(dmfReadOnly)가 있을 때만 비밀번호가 필요하다.
REDIS_PASSWORD=
MONGO_PASSWORD=

# 대상 REST API는 헤더 키를 요구하지 않는다 — 그래서 여기에 키가 없다.

# ─── LLM 게이트웨이 (7단계) ──────────────────────────────────────
# OpenAI 규약인데 인증만 다르다 — Authorization이 아니라 헤더 셋이 한다.
#   LLM_PASS_KEY   → X-FABRIX-CLIENT
#   LLM_CLIENT_KEY → X-OPENAPI-TOKEN
#
# 모델 ID는 비밀이 아니므로 config의 llm.model_id에 적는다(→ X-LLM-MODEL-ID).
# 키에 전각 문자나 공백이 섞이면 기동에서 거부한다 — HTTP 헤더는 ASCII만 싣는다.
LLM_BASE_URL=
LLM_PASS_KEY=
LLM_CLIENT_KEY=

# ─── 메일 Agent (8단계) ──────────────────────────────────────────
# LLM과는 **다른 API**다. x-api-key 헤더로 인증한다.
# api_base·recipients는 비밀이 아니므로 config의 mail 블록에 적는다.
# agent_id는 비밀은 아니지만 배치마다 다를 수 있어 env로도 받을 수 있게 뒀다 —
# 고정이면 config에 그대로 적어도 된다.
MAIL_AGENT_API_KEY=
MAIL_AGENT_ID=

# 실제 값은 .env에 넣는다(.gitignore됨). 이 파일은 "어떤 키가 필요한가"의 문서다.
# config가 ${...}로 참조하는 키가 비어 있으면 기동이 거부된다 — 빈 값도 없는 것으로 친다.

# ─── 대상 시스템: mx/gumi ────────────────────────────────────────
# Redis는 username 없이 비밀번호만. Mongo는 dmfReadOnly(role: read, db: data).
MX_GUMI_REDIS_PASSWORD=
MX_GUMI_MONGO_PASSWORD=

# ─── 사내 LLM 게이트웨이 (7단계부터 사용) ─────────────────────────
# 인증은 Authorization이 아니라 헤더 셋이 한다.
LLM_BASE_URL=
LLM_PASS_KEY=
LLM_CLIENT_KEY=

# ─── 메일 발송 API (12단계부터 사용) ─────────────────────────────
# LLM과는 다른 API다 — 보고서를 메일로 보낼 때 쓴다.
GAUSS_AGENT_API_KEY=

# 실제 값은 .env에 (gitignore됨). 이 파일은 키 목록의 문서다.
# config가 참조하는 키가 비어 있거나 없으면 기동이 거부된다.

# ─── 에이전트 자신의 저장소 (계획 2부터 사용) ─────────────────
AGENT_MONGO_URL=mongodb://localhost:27017

# ─── 사내 LLM 게이트웨이 (FabriX/Gauss) ───────────────────────
# 인증은 Authorization이 아니라 헤더 셋(X-FABRIX-CLIENT / X-OPENAPI-TOKEN /
# X-LLM-MODEL-ID)이 한다. 넷 다 config/app.json의 llm.gateway가 ${...}로 참조하며,
# 비어 있으면 기동이 거부된다.
GAUSS_LLM_BASE_URL=https://genai-openapi.sec.samsung.net/dxhq/trial/api-llm/openapi/llm
GAUSS_LLM_PASS_KEY=change-me
GAUSS_LLM_CLIENT_KEY=change-me
GAUSS_LLM_MODEL_ID=change-me

# 사내 루트 CA가 기본 신뢰 저장소에 없어 TLS가 실패하면 config/app.json의
# llm.gateway에 다음 중 하나를 적는다(env가 아니라 config다):
#   "ca_bundle": "/etc/ssl/certs/samsung-root-ca.pem"   ← 권장
#   "tls_verify": false                                  ← 번들을 구하기 전 임시
# 둘을 함께 적으면 스키마가 거부한다. 범위는 LLM 커넥션 하나이고,
# 대상 시스템(Mongo/Redis/Kafka/REST) 접속의 검증에는 영향이 없다.

# ─── 대상 시스템: mx/gumi (인증 없는 법인 — URL만) ─────────────
MX_GUMI_REDIS_URL=redis://gumi-redis:6379/0
MX_GUMI_MONGO_URL=mongodb://gumi-mongo:27017
MX_GUMI_KAFKA_BOOTSTRAP=gumi-kafka:9092
MX_GUMI_API_BASE=http://gumi-twin-api:8080

# ─── 대상 시스템: mx/suwon (인증 있는 법인 — 계정 키 추가) ──────
# MX_SUWON_REDIS_URL=redis://suwon-redis:6379/0
# MX_SUWON_REDIS_PASSWORD=change-me
# MX_SUWON_MONGO_URL=mongodb://suwon-mongo:27017
# MX_SUWON_MONGO_USER=twin_reader          # 읽기 전용 계정 권장
# MX_SUWON_MONGO_PASSWORD=change-me
